# Настройки Apache для banivyatki.ru (хостинг Beget).
# Файл лежит в public/ и попадает в корень сборки (dist/) при каждом npm run build.
# Переадресацию с HTTP на HTTPS здесь не прописываем: она включена на стороне хостинга.

# Без листинга директорий
Options -Indexes

# www.banivyatki.ru → banivyatki.ru
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.banivyatki\.ru$ [NC]
  RewriteRule ^(.*)$ https://banivyatki.ru/$1 [R=301,L]
</IfModule>

# Типы файлов, которых может не быть в настройках сервера
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Сжатие gzip: html, css, js, svg (и json на будущее — ответы обработчика заявок)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Кэширование.
#   /assets/   — год: в именах файлов хеш, при изменении меняется имя;
#   шрифты    — год;
#   картинки вне /assets/ (фото под постоянными именами, favicon, og) — 7 дней:
#               кадры заменяются под тем же именем, вернувшийся посетитель
#               должен увидеть новый не позже чем через неделю;
#   html      — без кэша (всегда перепроверяется).
# Заголовок Cache-Control ставит mod_headers; mod_expires дублирует те же сроки
# в Expires для старых клиентов. Правило для /assets/ в <If> — оно применяется
# после <FilesMatch> и перекрывает их.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
